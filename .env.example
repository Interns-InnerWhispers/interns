# Copy to .env for local runs. On Render, set these under Environment. Never commit real values.

NODE_ENV=production
PORT=3006

# Signs every login. REQUIRED, at least 32 random characters, or the server will not start.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Interns type this on the sign-up page. Share it only with new interns; change it each batch.
INTERN_INVITE_CODE=

# Websites allowed to call the API from a browser (comma-separated)
ALLOWED_ORIGINS=https://innerwhispers.in,https://www.innerwhispers.in

# Hostinger MySQL (hPanel → Databases → Remote MySQL: allow Render's outbound IPs only)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Cloudinary (profile photos)
CLOUDINARY_CLOUDNAME=
CLOUDINARY_API=
CLOUDINARY_APISEC=

# Email (Brevo API key, or SMTP)
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InnerWhispers Wellness LLP <no-reply@innerwhispers.in>"
HR_EMAIL=

# Google Gemini (dream reflection feature)
GEMINI_API=
